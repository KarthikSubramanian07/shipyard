# Public (non-secret) build-time config for production builds.
# NEXT_PUBLIC_* values are inlined into the bundle at `next build`.
# Update this when you point a custom domain at the Worker.
NEXT_PUBLIC_APP_URL=https://shipyard.karthik-e5e.workers.dev
NEXT_PUBLIC_SITE_NAME=Shipyard
# Set once the Rust OG worker is deployed, e.g. https://shipyard-og.<sub>.workers.dev
# NEXT_PUBLIC_OG_URL=

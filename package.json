{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "description": "Letterboxd for every story you've ever loved - and the ones you wish existed.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @shipyard/web dev",
    "build": "pnpm --filter @shipyard/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @shipyard/web db:generate",
    "db:migrate:local": "pnpm --filter @shipyard/web db:migrate:local",
    "db:seed": "pnpm --filter @shipyard/web db:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": ">=0.45.2",
      "happy-dom": ">=20.8.9",
      "vite": "^6.4.3",
      "esbuild": ">=0.25.0",
      "ws": ">=8.18.3",
      "postcss": ">=8.4.49",
      "launch-editor": ">=2.11.1",
      "wrangler": ">=4.59.1"
    }
  }
}
